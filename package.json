{
  "name": "pi-pii-redact",
  "version": "0.1.0",
  "description": "Pi extension to detect and redact PII and sensitive tokens from user prompts, tool results, and context",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "dependencies": {
    "@desert-ant-labs/redact": "4.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
