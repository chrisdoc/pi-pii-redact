{
  "name": "@chrisdoc/pi-pii-redact",
  "version": "0.2.0",
  "description": "Pi extension to detect and redact PII and sensitive tokens from user prompts, tool results, and context",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pii",
    "redaction",
    "privacy",
    "llm"
  ],
  "license": "MIT",
  "author": "Christoph Kieslich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdoc/pi-pii-redact.git"
  },
  "homepage": "https://github.com/chrisdoc/pi-pii-redact#readme",
  "bugs": {
    "url": "https://github.com/chrisdoc/pi-pii-redact/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "changeset": "changeset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "dependencies": {
    "@desert-ant-labs/redact": "4.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
